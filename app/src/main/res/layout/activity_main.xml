<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- اسم التمرين (إجباري) -->
    <EditText
        android:id="@+id/etname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_name"
        android:inputType="text"
        android:maxLines="1" />

    <!-- المدة بالدقائق (رقم) -->
    <EditText
        android:id="@+id/etduration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_duration"
        android:inputType="number"
        android:maxLines="1" />

    <!-- المجموعة العضلية (اختياري) -->
    <EditText
        android:id="@+id/etgroub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_group"
        android:inputType="text"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/cbcompleted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_completed" />

    <Button
        android:id="@+id/btadd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bt_add" />

    <!-- البحث -->
    <EditText
        android:id="@+id/etsearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_search"
        android:inputType="text"
        android:maxLines="1" />

    <!-- قائمة التمارين -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        tools:listitem="@layout/activity_item" />

</LinearLayout>
